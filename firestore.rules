rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email']) &&
             data.keys().hasOnly(['id', 'name', 'email', 'level', 'xp', 'streak', 'lastActiveDate', 'joinedDate', 'settings']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'title', 'language', 'ownerId']) &&
             data.keys().hasOnly(['id', 'title', 'description', 'language', 'files', 'ownerId', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.language is string && data.language.size() <= 30 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
             (!('files' in data) || (data.files is list && data.files.size() <= 50));
    }

    // Test connection doc (for connectivity probe)
    match /test/{testId} {
      allow read: if true;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().id == userId;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().id == userId;
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // User projects
    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(projectId) && incoming().ownerId == request.auth.uid && isValidProject(incoming());
      allow update: if isSignedIn() && isValidId(projectId) && existing().ownerId == request.auth.uid && incoming().ownerId == request.auth.uid && isValidProject(incoming());
      allow delete: if isSignedIn() && isValidId(projectId) && existing().ownerId == request.auth.uid;
    }
  }
}
