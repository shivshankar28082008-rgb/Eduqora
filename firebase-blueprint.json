{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with learning statistics, streak, and preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "level": { "type": "number" },
        "xp": { "type": "number" },
        "streak": { "type": "number" },
        "lastActiveDate": { "type": "string", "maxLength": 30 },
        "joinedDate": { "type": "string", "maxLength": 30 }
      },
      "required": ["id", "name", "email"]
    },
    "Project": {
      "title": "Project",
      "description": "User coding projects stored in Cloud Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "language": { "type": "string", "maxLength": 30 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "title", "language", "ownerId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "User profile documents keyed by Firebase Auth UID"
    },
    "/projects/{projectId}": {
      "schema": "#/entities/Project",
      "description": "Coding projects created by users"
    }
  }
}
