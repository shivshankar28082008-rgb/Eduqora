# ====================================================================
# Codevaible - Apache & LiteSpeed Configuration (Optimized for Hostinger)
# ====================================================================

# 1. Prevent Directory Indexing
Options -Indexes

# 2. Set Default Document
DirectoryIndex index.html index.htm

# 3. Default Character Encoding
AddDefaultCharset UTF-8

# 4. Strict MIME Types (Fixes ES Module "strict MIME checking" error on Hostinger)
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
  AddType font/eot .eot
  AddType font/otf .otf
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/webp .webp
  AddType image/gif .gif
  AddType image/x-icon .ico
  AddType audio/mpeg .mp3
  AddType video/mp4 .mp4
</IfModule>

# 5. Security & Browser Headers
<IfModule mod_headers.c>
  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"
  # Enable CORS for assets/fonts
  Header set Access-Control-Allow-Origin "*"
</IfModule>

# 6. Browser Caching for Production Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 7. Single Page Application (SPA) URL Rewriting
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass through existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirect all other requests to index.html for client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

# 8. Gzip / Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/javascript text/javascript text/css application/json image/svg+xml text/html text/plain font/woff2
</IfModule>
